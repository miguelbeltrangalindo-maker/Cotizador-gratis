# ---------------------------------------------------------------------------
# Cotizador — variables de entorno. Copia este archivo a .env y ajusta.
# NUNCA subas tu .env al repositorio.
# ---------------------------------------------------------------------------

# Conexión de la APLICACIÓN: rol NO privilegiado (sin BYPASSRLS, no dueño de tablas).
# Las políticas RLS de PostgreSQL se aplican a este rol.
DATABASE_URL=postgres://cotizador_app:cambia_esta_clave_app@localhost:5432/cotizador

# Conexión ADMINISTRATIVA: dueño del esquema. Solo para migraciones y seed de desarrollo.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/cotizador

# Secreto para firmar/hashear tokens de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# URL pública de la aplicación (en producción debe ser https://)
APP_URL=http://localhost:3000

# Almacenamiento de logos: "database" (por defecto, privado en PostgreSQL) o "local" (carpeta privada)
STORAGE_DRIVER=database
STORAGE_LOCAL_DIR=./storage

# Datos de demostración: solo se permiten si es "true" y NODE_ENV != production
ENABLE_DEMO_SEED=false

# Correo (opcional; si no se configura, NO se envían correos y el restablecimiento
# de contraseña se hace con el comando local `npm run user:reset-password`).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
